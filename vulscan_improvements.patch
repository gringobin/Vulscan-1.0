+def normalize_service(raw: Optional[str], banner: Optional[str]) -> Tuple[str, Optional[str]]:
+    \"\"\"Best-effort return (service, version) from raw service string and banner text.\"\"\"
+    s = (raw or '').lower().strip()
+    b = (banner or '').lower()
+    if s:
+        key = COMMON_SERVICE_ALIASES.get(s, s)
+        v = extract_version_from_banner(b) or None
+        return key, v
+    for k in ('apache', 'nginx', 'microsoft-iis', 'openssh', 'tomcat', 'jetty', 'haproxy'):
+        if k in b:
+            svc = COMMON_SERVICE_ALIASES.get(k, k)
+            v = extract_version_from_banner(b)
+            return svc, v
+    return 'unknown', None
+
+def extract_version_from_banner(banner: str) -> Optional[str]:
+    if not banner:
+        return None
+    # find common version substrings like 1.2.3 or 2.4 or 3.4.5-beta
+    m = re.search(r'([0-9]+(?:\.[0-9a-zA-Z\-\_]+)+)', banner)
+    if m:
+        return sanitize_version(m.group(1))
+    return None
+
+def to_cpe_like(service: str, version: Optional[str]) -> str:
+    svc = service.replace(' ', '_')
+    if version:
+        v = sanitize_version(version)
+        return f'cpe:/a:{svc}:{v}'
+    return f'cpe:/a:{svc}'
+
