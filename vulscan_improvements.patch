+def parse_ports(s: str) -> List[int]:
+    ports = set()
+    for part in s.split(','):
+        part = part.strip()
+        if not part:
+            continue
+        if '-' in part:
+            a,b = part.split('-',1)
+            ports.update(range(int(a), int(b)+1))
+        else:
+            ports.add(int(part))
+    return sorted(p for p in ports if 1 <= p <= 65535)
+
+def sanitize_version(v: str) -> str:
+    if not v:
+        return ''
+    v = v.strip()
+    v = re.sub(r'[^0-9a-zA-Z\.\-\_]', '_', v)
+    return v
