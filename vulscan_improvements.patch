+\"\"\"\n+Async scanner: high-concurrency TCP connect + protocol probes and banner grabbing.\n+Designed to replace external dependencies like nmap for service/version detection.\n+\"\"\"\n+import asyncio\n+import socket\n+import ssl\n+from typing import List, Optional\n+from .utils import parse_ports, MAX_CONCURRENCY\n+from .fingerprint_ext import normalize_service\n+\n+\n+class PortResult:\n+    def __init__(self, port:int, proto:str='tcp', state:str='open', banner:Optional[str]=None, service:Optional[str]=None, version:Optional[str]=None, extras:dict=None):\n+        self.port = port\n+        self.proto = proto\n+        self.state = state\n+        self.banner = banner\n+        self.service = service\n+        self.version = version\n+        self.extras = extras or {}\n+\n+\n+async def _read_some(reader: asyncio.StreamReader, timeout: float=1.0) -> bytes:\n+    try:\n+        return await asyncio.wait_for(reader.read(4096), timeout=timeout)\n+    except Exception:\n+        return b''\n+\n+\n+async def probe_host_port(host: str, port: int, timeout: float=2.0) -> Optional[PortResult]:\n+    try:\n+        reader, writer = await asyncio.open_connection(host, port)\n+    except Exception:\n+        return None\n+\n+    banner = None\n+    service = None\n+    version = None\n+\n+    try:\n+        # lightweight HTTP probe\n+        if port in (80, 8080, 8000, 8008):\n+            writer.write(b\"GET / HTTP/1.0\\r\\nHost: localhost\\r\\nUser-Agent: Vulscan\\r\\n\\r\\n\")\n+            await writer.drain()\n+            data = await _read_some(reader)\n+            if data:\n+                text = data.decode(errors='ignore')\n+                banner = text.split('\\r\\n\\r\\n',1)[0]\n+                import re\n+                m = re.search(r'Server:\\s*([^\\r\\n]+)', text, re.I)\n+                if m:\n+                    service = 'http'\n+                    version = m.group(1).strip()\n+\n+        elif port in (443, 8443):\n+            # close asyncio connection; do TLS socket to get cert\n+            try:\n+                writer.close()\n+                await writer.wait_closed()\n+            except Exception:\n+                pass\n+            try:\n+                ctx = ssl.create_default_context()\n+                with socket.create_connection((host, port), timeout=timeout) as sock:\n+                    with ctx.wrap_socket(sock, server_hostname=host) as ssock:\n+                        cert = ssock.getpeercert()\n+                        subj = cert.get('subject', ())\n+                        cn = None\n+                        for part in subj:\n+                            for kv in part:\n+                                if kv[0].lower() == 'commonname':\n+                                    cn = kv[1]\n+                        banner = f\"TLS cert CN={cn} SAN={cert.get('subjectAltName')}\"\n+                        service = 'https'\n+            except Exception:\n+                pass\n+\n+        elif port == 22:\n+            data = await _read_some(reader, timeout=1.0)\n+            if data:\n+                text = data.decode(errors='ignore').strip()\n+                banner = text\n+                import re\n+                m = re.match(r'SSH-([0-9\\.]+)-(.+)', text)\n+                if m:\n+                    service = 'ssh'\n+                    version = m.group(2)\n+\n+        else:\n+            # generic banner grab\n+            try:\n+                writer.write(b\"\\r\\n\")\n+                await writer.drain()\n+            except Exception:\n+                pass\n+            data = await _read_some(reader, timeout=0.8)\n+            if data:\n+                banner = data.decode(errors='ignore').strip()\n+\n+    except Exception:\n+        pass\n+    finally:\n+        try:\n+            writer.close()\n+            await writer.wait_closed()\n+        except Exception:\n+            pass\n+\n+    svc, ver = normalize_service(service, banner)\n+    if ver is None and version:\n+        ver = version\n+\n+    return PortResult(port=port, proto='tcp', state='open', banner=banner, service=svc, version=ver)\n+\n+\n+async def scan(target: str, ports: List[int], timeout: float=2.0) -> List[PortResult]:\n+    sem = asyncio.Semaphore(MAX_CONCURRENCY)\n+    results = []\n+\n+    async def worker(p):\n+        async with sem:\n+            try:\n+                r = await probe_host_port(target, p, timeout=timeout)\n+                if r:\n+                    results.append(r)\n+            except Exception:\n+                pass\n+\n+    tasks = [asyncio.create_task(worker(p)) for p in ports]\n+    await asyncio.gather(*tasks)\n+    return sorted(results, key=lambda x: x.port)\n+\n+\n+def sync_scan(target: str, ports_spec: str, timeout: float=2.0):\n+    ports = parse_ports(ports_spec)\n+    loop = None\n+    try:\n+        loop = asyncio.get_event_loop()\n+    except RuntimeError:\n+        loop = asyncio.new_event_loop()\n+        asyncio.set_event_loop(loop)\n+    return loop.run_until_complete(scan(target, ports, timeout=timeout))\n+\n*** End File
